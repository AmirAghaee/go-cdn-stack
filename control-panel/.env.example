APP_URL=127.0.0.1:9001
MONGO_URI=mongodb://admin:admin@localhost:27017/?authSource=admin
MONGO_DB=cdndb
NATS_URL=nats://localhost:4222
# Development only; use a strong secret in shared and production environments.
JWT_SECRET=local-development-secret
JWT_DURATION=24h
# Must match edge; this credential can access only the edge snapshot route.
EDGE_SERVICE_TOKEN=local-edge-service-token
