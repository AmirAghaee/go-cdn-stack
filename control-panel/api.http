@baseUrl = http://127.0.0.1:9001

### USER LOGIN
# This request stores the token into the token variable
# After running this, all other API calls automatically use the token
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "amir.aghaee73@gmail.com",
  "password": "amir24"
}
> {%
    client.global.set("token", response.body.token);
%}

### USERS LIST
GET {{baseUrl}}/api/users
Accept: application/json
Authorization: Bearer {{token}}

### USER CHANGE PASSWORD
# Existing JWTs remain valid until their configured expiration.
PUT {{baseUrl}}/api/users/68caa221474affe1e9d178c4/password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "password": "new-secure-password"
}

### USER DELETE
# Administrators cannot delete their own account. Existing JWTs remain valid until expiration.
DELETE {{baseUrl}}/api/users/68caa221474affe1e9d178c4
Accept: application/json
Authorization: Bearer {{token}}

### USER REGISTER
POST {{baseUrl}}/api/register
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "amir.aghaee73@gmail.com",
  "password": "amir24"
}

### CDNS LIST
GET {{baseUrl}}/api/cdns
Content-Type: application/json
Authorization: Bearer {{token}}

### CDN CREATE
POST {{baseUrl}}/api/cdns
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "origin": "http://127.0.0.1:8081",
  "domain": "example.com",
  "cache_ttl": 60,
  "is_active": true
}

### CDN DETAILS
GET {{baseUrl}}/api/cdns/68caa221474affe1e9d178c4
Accept: application/json
Authorization: Bearer {{token}}

### CDN UPDATE
PUT {{baseUrl}}/api/cdns/68caa221474affe1e9d178c4
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "origin": "http://127.0.0.1:8081",
  "domain": "example.com",
  "cache_ttl": 120,
  "is_active": true
}

### CDN DELETE
DELETE {{baseUrl}}/api/cdns/68caa221474affe1e9d178c4
Content-Type: application/json
Authorization: Bearer {{token}}

### SNAPSHOT
POST {{baseUrl}}/api/snapshot
Content-Type: application/json
Authorization: Bearer {{token}}

### EDGE NODE HEALTH
GET {{baseUrl}}/api/health/nodes
Accept: application/json
Authorization: Bearer {{token}}
