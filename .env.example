# Optional Docker Compose overrides. The stack runs without a .env file.
# Replace this development value for any shared or production deployment.
JWT_SECRET=local-development-secret
# Dedicated read-only credential shared only by control-panel and edge.
EDGE_SERVICE_TOKEN=local-edge-service-token
# Grafana login is admin/<this value>. Replace it outside local development.
GRAFANA_ADMIN_PASSWORD=admin
