APP_NAME=EDGE01
# Supported values: debug, release, test
APP_MODE=debug
APP_CACHE_URL=127.0.0.1:8080
APP_INTERNAL_URL=127.0.0.1:8090
CONTROL_PANEL_URL=http://127.0.0.1:9001
NATS_URL=nats://127.0.0.1:4222
# Must match the control panel. Use a strong secret outside local development.
JWT_SECRET=local-development-secret
CDN_SNAPSHOT_FILE=./cache/cdns.json
CDN_SYNC_INTERVAL=60
CACHE_TTL=10
CACHE_CLEANER_TTL=60
# 0 allows cacheable objects of any size. Set a positive byte limit when needed.
CACHE_MAX_OBJECT_SIZE_BYTES=0
CACHE_DIR=./cache
METADATA_EXT=.meta
