APP_NAME=EDGE01
# Supported values: debug, release, test
APP_MODE=debug
APP_CACHE_URL=127.0.0.1:8080
APP_INTERNAL_URL=127.0.0.1:8090
CONTROL_PANEL_URL=http://127.0.0.1:9001
NATS_URL=nats://127.0.0.1:4222
# Must match the control panel. It grants access only to the snapshot route.
EDGE_SERVICE_TOKEN=local-edge-service-token
CDN_SNAPSHOT_FILE=./cache/cdns.json
CDN_SYNC_INTERVAL=60
CACHE_TTL=10
CACHE_CLEANER_TTL=60
# 0 allows cacheable objects of any size. Set a positive byte limit when needed.
CACHE_MAX_OBJECT_SIZE_BYTES=0
CACHE_DIR=./cache
METADATA_EXT=.meta
# Origins may resolve only to public IP addresses by default. Add the narrowest
# private CIDRs required for explicitly approved internal origins.
# Example: ORIGIN_ALLOWED_CIDRS=10.20.30.0/24,2001:db8:1234::/48
ORIGIN_ALLOWED_CIDRS=
# Comma-separated CIDRs of proxies that sanitize/append X-Forwarded-For and
# overwrite X-Forwarded-Proto. Empty trusts no proxy; never use all-network CIDRs.
# Example: TRUSTED_PROXIES=10.20.0.0/24,2001:db8:1234::/48
# Edge keeps the first untrusted hop and trusted suffix, then appends its peer.
# Forwarded/X-Real-IP/other X-Forwarded-* are removed. X-Forwarded-Host uses the
# incoming Host; the upstream HTTP Host uses the configured origin authority.
TRUSTED_PROXIES=
